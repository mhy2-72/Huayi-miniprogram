.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.empty {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
}

.log-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.log-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.log-item:last-child {
  border-bottom: none;
}

.log-left {
  flex: 1;
}

.log-desc {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.log-time {
  font-size: 24rpx;
  color: #999;
}

.log-amount {
  font-size: 36rpx;
  font-weight: bold;
  margin-left: 20rpx;
}

.income {
  color: #07c160;
}

.expense {
  color: #ff3b30;
}