/* pages/publish/publish.wxss */

/* ========== 原有样式 ========== */
textarea {
  width: 100%;
  height: 300rpx;
  border: 1px solid #ddd;
  border-radius: 10rpx;
  padding: 20rpx;
  box-sizing: border-box;
  margin-bottom: 40rpx;
  font-size: 30rpx;
}

.submit-btn {
  width: 100%;
  background: #07c160;
  color: #fff;
  border-radius: 10rpx;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 32rpx;
}

.submit-btn[disabled] {
  background: #ccc;
  color: #999;
}

.section {
  margin-bottom: 20rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.img-list {
  display: flex;
  flex-wrap: wrap;
}

.upload-img {
  width: 200rpx;
  height: 200rpx;
  margin-right: 15rpx;
  margin-bottom: 15rpx;
  border-radius: 10rpx;
}

.add-btn {
  width: 200rpx;
  height: 200rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  color: #999;
  border-radius: 10rpx;
  border: 2rpx dashed #ddd;
}


/* ========== ✅ 新增：资质认证弹窗样式 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  width: 90%;
  max-height: 85vh;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  animation: modalSlideIn 0.3s ease;
}

@keyframes modalSlideIn {
  from {
    transform: translateY(60rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
  line-height: 1;
}

.modal-body {
  padding: 30rpx;
  max-height: 50vh;
  overflow-y: auto;
}

/* 提示区域 */
.cert-tip {
  background: #fff3cd;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #ffc107;
}

.tip-icon {
  font-size: 36rpx;
  margin-right: 15rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 28rpx;
  color: #856404;
  flex: 1;
  line-height: 1.6;
}

/* 资质类型标签 */
.cert-types {
  margin-bottom: 28rpx;
}

.types-label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

.types-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.tag {
  background: #e3f2fd;
  color: #0d47a1;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* 资质图片上传 */
.cert-upload-section {
  margin-top: 10rpx;
}

.cert-label {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.cert-img-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cert-img-wrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.cert-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.delete-btn {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 44rpx;
  height: 44rpx;
  background: #dc3545;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(220, 53, 69, 0.4);
}

.cert-add-btn {
  width: 160rpx;
  height: 160rpx;
  background: #f8f9fa;
  border: 3rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: #bbb;
  transition: all 0.2s;
}

.cert-add-btn:active {
  background: #e9ecef;
  border-color: #999;
}

.cert-hint {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 12rpx;
}

/* 底部按钮 */
.modal-footer {
  display: flex;
  padding: 20rpx 30rpx 30rpx;
  gap: 20rpx;
  border-top: 2rpx solid #f0f0f0;
}

.cert-cancel-btn {
  flex: 1;
  background: #f5f5f5;
  color: #666;
  border-radius: 12rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}

.cert-cancel-btn:active {
  background: #e8e8e8;
}

.cert-confirm-btn {
  flex: 2;
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.cert-confirm-btn:active {
  background: #06ad56;
}

/* 滚动条美化 */
.modal-body::-webkit-scrollbar {
  width: 4rpx;
}

.modal-body::-webkit-scrollbar-thumb {
  background: #ddd;
  border-radius: 4rpx;
}

.modal-body::-webkit-scrollbar-track {
  background: transparent;
}

/* ========== 容器样式 ========== */
.container {
  padding: 30rpx;
  background: #f8f9fa;
  min-height: 100vh;
}