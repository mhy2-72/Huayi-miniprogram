textarea {
  width: 100%;
  height: 300rpx;
  border: 1px solid #ddd;
  border-radius: 10rpx;
  padding: 20rpx;
  box-sizing: border-box;
  margin-bottom: 40rpx;
  font-size: 30rpx;
}
.submit-btn {
  width: 100%;
  background: #07c160;
  color: #fff;
}
.section { margin-bottom: 20rpx; }
.label { font-size: 28rpx; color: #333; margin-bottom: 10rpx; display: block; }
.img-list { display: flex; flex-wrap: wrap; }
.upload-img { width: 200rpx; height: 200rpx; margin-right: 15rpx; margin-bottom: 15rpx; border-radius: 10rpx; }
.add-btn { width: 200rpx; height: 200rpx; background: #f5f5f5; display: flex; align-items: center; justify-content: center; font-size: 80rpx; color: #999; border-radius: 10rpx; }