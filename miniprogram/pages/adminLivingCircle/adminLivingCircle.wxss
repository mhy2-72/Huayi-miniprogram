.container { min-height: 100vh; background: #f5f5f5; }
.section { background: #fff; margin-bottom: 20rpx; padding: 24rpx; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.section-title { font-size: 32rpx; font-weight: bold; }
.mini-btn { font-size: 24rpx; padding: 8rpx 20rpx; background: #07c160; color: #fff; border-radius: 24rpx; line-height: 1.4; height: auto; min-height: auto; }

.category-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.category-item { display: flex; align-items: center; padding: 16rpx 24rpx; background: #f2f3f5; border-radius: 32rpx; font-size: 28rpx; }
.category-item.active { background: #e6f7ff; color: #1890ff; }
.cat-delete { margin-left: 12rpx; color: #ff4d4f; font-size: 28rpx; }
.cat-key { color: #07c160; font-weight: bold; font-size: 26rpx; }
.cat-sep { color: #ccc; margin: 0 6rpx; }
.cat-name { font-size: 26rpx; color: #333; }

.picker-text {
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 14rpx;
  font-size: 28rpx;
  background: #f9f9f9;
}
.picker-text.empty {
  color: #999;
}

.poi-list { }
.poi-card { background: #f9f9f9; border-radius: 12rpx; padding: 20rpx; margin-bottom: 16rpx; }
.poi-head { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.poi-name { font-size: 30rpx; font-weight: bold; color: #333; }
.poi-cat { font-size: 24rpx; color: #07c160; }
.poi-address { font-size: 26rpx; color: #666; margin-bottom: 8rpx; }
.poi-meta { display: flex; justify-content: space-between; align-items: center; font-size: 24rpx; color: #999; }
.action-links { display: flex; gap: 20rpx; }
.link { color: #07c160; }
.link.danger { color: #ff4d4f; }

.empty { text-align: center; color: #999; padding: 40rpx 0; }

.modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center; }
.modal-content { width: 90%; max-height: 85vh; overflow-y: auto; background: #fff; border-radius: 24rpx; padding: 30rpx; }
.modal-title { font-size: 34rpx; font-weight: bold; text-align: center; margin-bottom: 24rpx; }
.form-item { margin-bottom: 16rpx; }
.form-item.half { flex: 1; }
.form-row { display: flex; gap: 16rpx; }
.form-label { font-size: 26rpx; color: #666; display: block; margin-bottom: 8rpx; }
.form-input { border: 1rpx solid #ddd; border-radius: 8rpx; padding: 14rpx; font-size: 28rpx; }
.form-textarea { border: 1rpx solid #ddd; border-radius: 8rpx; padding: 14rpx; font-size: 28rpx; width: 100%; min-height: 100rpx; }
.modal-actions { display: flex; gap: 20rpx; margin-top: 20rpx; }
.btn-cancel { flex: 1; background: #f2f3f5; color: #666; border-radius: 40rpx; font-size: 30rpx; }
.btn-save { flex: 1; background: #07c160; color: #fff; border-radius: 40rpx; font-size: 30rpx; }

.address-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.address-input {
  flex: 1;
}

.location-btn {
  font-size: 24rpx;
  padding: 12rpx 20rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  line-height: 1.4;
  height: auto;
  min-height: auto;
  white-space: nowrap;
}

.location-hint {
  font-size: 22rpx;
  color: #07c160;
  margin-top: 6rpx;
}