/* pages/livingCircle/livingCircle.wxss */
.container {
  min-height: 100vh;
  background: #f6f6f6;
}

.disclaimer {
  text-align: center;
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
}

.location-banner {
  display: flex;
  align-items: center;
  background: #fffbe6;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #ffe58f;
}
.loc-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}
.loc-text {
  flex: 1;
  font-size: 26rpx;
  color: #d48806;
}
.loc-action {
  font-size: 26rpx;
  color: #1890ff;
  padding: 4rpx 16rpx;
  border: 1rpx solid #1890ff;
  border-radius: 24rpx;
}

/* 范围提示横幅 */
.range-banner {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: linear-gradient(90deg, #fff7e6 0%, #ffe4b5 100%);
  border-bottom: 1rpx solid #ffd591;
}
.range-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}
.range-text {
  flex: 1;
  font-size: 24rpx;
  color: #ad6800;
  line-height: 1.5;
}
.range-close {
  font-size: 36rpx;
  color: #ad6800;
  padding: 0 12rpx;
}

.search-bar {
  padding: 20rpx 24rpx;
  background: #fff;
}
.search-input {
  height: 72rpx;
  line-height: 72rpx;
  background: #f2f3f5;
  border-radius: 36rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
}
.category-bar {
  white-space: nowrap;
  background: #fff;
  padding: 10rpx 24rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.category-btn {
  display: inline-block;
  margin-right: 16rpx;
  padding: 12rpx 32rpx;
  background: #f2f3f5;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #333;
}
.category-btn.active {
  background: #07c160;
  color: #fff;
}

.range-tip {
  padding: 20rpx 24rpx;
  color: #ad6800;
  font-size: 26rpx;
  background: #fff7e6;
  border-bottom: 1rpx solid #ffe4b5;
}

.result-list {
  padding: 20rpx 24rpx;
}
.poi-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.poi-card.best {
  border: 2rpx solid #07c160;
}
.poi-card.out-range {
  opacity: 0.75;
  background: #f9f9f9;
}
.poi-card.out-range .poi-name {
  color: #666;
}
.poi-card.out-range .poi-desc {
  color: #999;
}

.poi-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.poi-name {
  font-size: 32rpx;
  font-weight: bold;
  flex: 1;
}
.best-tag {
  font-size: 22rpx;
  color: #e6a23c;
  border: 1rpx solid #e6a23c;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}
.range-tag {
  font-size: 20rpx;
  color: #999;
  background: #e8e8e8;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  margin-left: 12rpx;
}
.poi-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}
.poi-meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  font-size: 26rpx;
}
.poi-cat {
  color: #07c160;
  margin-right: 16rpx;
}
.poi-dist {
  color: #999;
  margin-right: 16rpx;
}
.poi-range {
  font-size: 22rpx;
  color: #07c160;
}
.out-range .poi-range {
  color: #999;
}
.poi-addr {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #666;
}
.poi-foot {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}
.poi-phone {
  margin-left: 24rpx;
}
.nav-hint {
  margin-left: auto;
  color: #07c160;
}
.empty {
  text-align: center;
  color: #999;
  padding: 60rpx 0;
}
