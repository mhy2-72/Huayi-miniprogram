.user-info {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 30rpx;
  border-radius: 10rpx;
  margin-bottom: 30rpx;
}
.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}
.nickname {
  font-size: 36rpx;
  font-weight: bold;
}
.login-hint {
  font-size: 26rpx;
  color: #07c160;
  margin-top: 10rpx;
}
.role {
  font-size: 28rpx;
  color: #888;
}
.points-box {
  background: #fff;
  padding: 30rpx;
  border-radius: 10rpx;
  text-align: center;
  margin-bottom: 30rpx;
}
.points-label {
  font-size: 28rpx;
  color: #888;
}
.points-value {
  font-size: 60rpx;
  color: #07c160;
  font-weight: bold;
}
.menu-list {
  background: #fff;
  border-radius: 10rpx;
}
.menu-item {
  padding: 25rpx;
  border-bottom: 1rpx solid #eee;
  font-size: 30rpx;
}
.menu-item:last-child {
  border-bottom: none;
}
/* 原有样式保持不变，菜单项增加间距 */
.container { padding: 20rpx; }
.user-info { display: flex; align-items: center; background: #fff; padding: 30rpx; border-radius: 10rpx; margin-bottom: 30rpx; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; margin-right: 20rpx; }
.nickname { font-size: 36rpx; font-weight: bold; }
.role { font-size: 28rpx; color: #888; }
.points-box { background: #fff; padding: 30rpx; border-radius: 10rpx; text-align: center; margin-bottom: 30rpx; }
.points-label { font-size: 28rpx; color: #888; }
.points-value { font-size: 60rpx; color: #07c160; font-weight: bold; }
.menu-list { background: #fff; border-radius: 10rpx; }
.menu-item { padding: 25rpx; border-bottom: 1rpx solid #eee; font-size: 30rpx; }
.menu-item:last-child { border-bottom: none; }
.logout-section {
  margin-top: 60rpx;
  padding: 20rpx;
}
.logout-btn {
  background: #ff3b30;
  color: #fff;
  font-size: 30rpx;  
}
.subscribe-section{
  margin-top: 20rpx;
  padding: 20rpx;
}
.subscribe-btn{
  background:#888;
  color:#fff;
  font-size: 30rpx;
}
.red-dot {
  background: #fa5151;
  color: white;
  border-radius: 50%;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 22rpx;
  padding: 0 6rpx;
  display: inline-block;
  margin-left: 10rpx;
}
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* AI入口按钮 */
.ai-section { margin-top: 40rpx; padding: 0 20rpx; }
.ai-btn {
  background: #FFD700;
  color: #000;
  font-size: 30rpx;
  font-weight: bold;
  border: 4rpx solid #FF8C00;
  border-radius: 10rpx;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
}

/* 申诉入口 */
.complaint-entry {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 30rpx 0 20rpx;
  padding: 30rpx;
  border-radius: 10rpx;
}
.complaint-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}
.complaint-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}
.complaint-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.cert-tags {
  margin-top: 8rpx;
}
.cert-tag {
  display: block;
  font-size: 22rpx;
  color: #fa8c16;
  background: #fffbe6;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-top: 6rpx;
  border: 1rpx solid #ffe58f;
}