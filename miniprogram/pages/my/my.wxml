<view class="container">
  <view class="user-info">
    <image src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" class="avatar"></image>
    <view class="user-detail">
      <text class="nickname">{{userInfo.nickName}}</text>
      <text class="role">{{roleText}}</text>
    </view>
  </view>

  <view class="points-box">
    <text class="points-label">我的积分</text>
    <text class="points-value">{{userInfo.points || 0}}</text>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goNotifications">通知中心</view>
    <view class="menu-item" bindtap="goPointHistory">积分变动记录</view>
    <view class="menu-item" bindtap="goAbout">关于我们</view>
  </view>
</view>