.container { min-height: 100vh; background: #f5f5f5; }
.filter-bar { display: flex; background: #fff; padding: 20rpx; gap: 16rpx; overflow-x: auto; white-space: nowrap; }
.filter-item { display: inline-block; padding: 12rpx 24rpx; border-radius: 32rpx; font-size: 26rpx; color: #666; background: #f2f3f5; flex-shrink: 0; }
.filter-item.active { background: #07c160; color: #fff; }

.task-list { padding: 20rpx; }
.task-card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; }
.task-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.task-title { font-size: 30rpx; font-weight: bold; color: #333; flex: 1; }
.task-status { font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 20rpx; }
.task-status.yellow { background: #fffbe6; color: #faad14; }
.task-status.gray { background: #f5f5f5; color: #999; }
.task-status.red { background: #fff1f0; color: #ff4d4f; }
.task-status.blue { background: #e6f7ff; color: #1890ff; }
.task-info { font-size: 26rpx; color: #666; display: flex; flex-direction: column; gap: 6rpx; margin-bottom: 10rpx; }
.task-meta { font-size: 24rpx; color: #999; display: flex; gap: 20rpx; }
.task-actions { display: flex; justify-content: flex-end; gap: 30rpx; border-top: 1rpx solid #f0f0f0; padding-top: 16rpx; margin-top: 12rpx; }
.action-link { font-size: 28rpx; color: #07c160; }
.action-link.danger { color: #ff4d4f; }

.empty { text-align: center; color: #999; padding: 80rpx 0; }

.modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center; }
.modal-content { width: 85%; background: #fff; border-radius: 24rpx; padding: 30rpx; }
.modal-title { font-size: 34rpx; font-weight: bold; text-align: center; margin-bottom: 24rpx; }
.form-item { margin-bottom: 20rpx; }
.form-label { font-size: 28rpx; color: #666; display: block; margin-bottom: 12rpx; }
.status-options { display: flex; flex-wrap: wrap; gap: 12rpx; }
.status-opt { padding: 12rpx 24rpx; border-radius: 32rpx; font-size: 26rpx; background: #f2f3f5; color: #666; }
.status-opt.active { background: #07c160; color: #fff; }
.rating-options { display: flex; gap: 12rpx; margin-bottom: 8rpx; }
.rating-opt { font-size: 48rpx; color: #ddd; }
.rating-opt.active { color: #faad14; }
.rating-val { font-size: 28rpx; color: #666; }
.modal-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.btn-cancel { flex: 1; background: #f2f3f5; color: #666; border-radius: 40rpx; font-size: 30rpx; }
.btn-save { flex: 1; background: #07c160; color: #fff; border-radius: 40rpx; font-size: 30rpx; }