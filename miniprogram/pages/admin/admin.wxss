.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* Header */
.header {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  padding: 60rpx 30rpx 40rpx;
  color: #fff;
}
.header-title {
  font-size: 44rpx;
  font-weight: bold;
  display: block;
}
.header-sub {
  font-size: 28rpx;
  opacity: 0.85;
  margin-top: 8rpx;
  display: block;
}

/* Stats Section */
.stats-section {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
  gap: 20rpx;
  margin-top: -20rpx;
}
.stat-card {
  flex: 1;
  min-width: 45%;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.stat-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #07c160;
}
.stat-value.pending { color: #fa8c16; }
.stat-label {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
}

/* Menu Grid */
.menu-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
  gap: 20rpx;
}
.menu-item {
  width: calc(33.33% - 14rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  position: relative;
}
.menu-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}
.menu-text {
  font-size: 26rpx;
  color: #333;
}
.menu-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: #fa5151;
  color: white;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

/* Bottom placeholder */
.bottom-placeholder {
  height: 40rpx;
}

/* Bottom Tab Bar */
.bottom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  z-index: 100;
  padding-bottom: env(safe-area-inset-bottom);
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 22rpx;
  position: relative;
}
.tab-item.active {
  color: #07c160;
}
.tab-icon {
  font-size: 44rpx;
  margin-bottom: 4rpx;
}
.tab-label {
  font-size: 22rpx;
}
.tab-badge {
  position: absolute;
  top: 8rpx;
  right: calc(50% - 60rpx);
  background: #fa5151;
  color: white;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

/* Redeem Section */
.redeem-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.redeem-section .section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}
.redeem-input-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.redeem-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}
.redeem-btn {
  height: 72rpx;
  padding: 0 36rpx;
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.redeem-btn.disabled {
  opacity: 0.6;
}
.redeem-result {
  margin-top: 20rpx;
  border-radius: 12rpx;
  padding: 20rpx;
  position: relative;
}
.redeem-result.success {
  background: #f6ffed;
  border: 1rpx solid #b7eb8f;
}
.redeem-result.fail {
  background: #fff1f0;
  border: 1rpx solid #ffa39e;
}
.redeem-result.block {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.result-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}
.result-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.result-title {
  font-size: 30rpx;
  font-weight: bold;
}
.success .result-title { color: #389e0d; }
.fail .result-title { color: #cf1322; }
.result-line {
  font-size: 26rpx;
  color: #666;
}
.result-close {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
