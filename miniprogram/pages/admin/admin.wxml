<view class="container">
  <!-- 头部 -->
  <view class="header">
    <text class="header-title">管理后台</text>
    <text class="header-sub">欢迎回来</text>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-section">
    <view class="stat-card" bindtap="goComplaints">
      <text class="stat-value pending">{{pendingCount}}</text>
      <text class="stat-label">待处理申诉</text>
    </view>
    <view class="stat-card" bindtap="goQualifications">
      <text class="stat-value pending">{{certPendingCount}}</text>
      <text class="stat-label">待审核资质</text>
    </view>
    <view class="stat-card" bindtap="goTasks">
      <text class="stat-value">{{taskCount}}</text>
      <text class="stat-label">任务总数</text>
    </view>
    <view class="stat-card" bindtap="goUsers">
      <text class="stat-value">{{userCount}}</text>
      <text class="stat-label">用户总数</text>
    </view>
  </view>

  <!-- 兑换码核销 -->
  <view class="redeem-section">
    <view class="section-title">🎟️ 兑换码核销</view>
    <view class="redeem-input-row">
      <input class="redeem-input" placeholder="输入兑换码" value="{{redeemCode}}" bindinput="onRedeemInput" confirm-type="done" bindconfirm="doRedeem"/>
      <view class="redeem-btn {{redeemLoading ? 'disabled' : ''}}" bindtap="doRedeem">
        {{redeemLoading ? '核销中...' : '核销'}}
      </view>
    </view>

    <!-- 核销结果 -->
    <view wx:if="{{redeemResult}}" class="redeem-result {{redeemResult.success ? 'success' : 'fail'}}">
      <block wx:if="{{redeemResult.success}}">
        <view class="result-icon">✅</view>
        <view class="result-info">
          <text class="result-title">核销成功</text>
          <text class="result-line">兑换码：{{redeemResult.code}}</text>
          <text class="result-line">商品：{{redeemResult.productName}}</text>
          <text class="result-line">用户：{{redeemResult.userName}}</text>
          <text class="result-line">消耗积分：{{redeemResult.pointsCost}}</text>
        </view>
        <view class="result-close" bindtap="clearRedeem">✕</view>
      </block>
      <block wx:else>
        <view class="result-icon">❌</view>
        <view class="result-info">
          <text class="result-title">无效</text>
          <text class="result-line">{{redeemResult.msg}}</text>
        </view>
        <view class="result-close" bindtap="clearRedeem">✕</view>
      </block>
    </view>
  </view>

  <!-- 功能入口网格 -->
  <view class="menu-grid">
    <view class="menu-item" bindtap="goComplaints">
      <view class="menu-icon">📋</view>
      <text class="menu-text">申诉处理</text>
      <view wx:if="{{pendingCount > 0}}" class="menu-badge">{{pendingCount}}</view>
    </view>
    <view class="menu-item" bindtap="goQualifications">
      <view class="menu-icon">🛡️</view>
      <text class="menu-text">资质认证</text>
      <view wx:if="{{certPendingCount > 0}}" class="menu-badge">{{certPendingCount}}</view>
    </view>
    <view class="menu-item" bindtap="goTasks">
      <view class="menu-icon">📝</view>
      <text class="menu-text">任务管理</text>
    </view>
    <view class="menu-item" bindtap="goUsers">
      <view class="menu-icon">👥</view>
      <text class="menu-text">用户管理</text>
    </view>
    <view class="menu-item" bindtap="goLivingCircle">
      <view class="menu-icon">📍</view>
      <text class="menu-text">生活圈管理</text>
    </view>
    <view class="menu-item" bindtap="goProducts">
      <view class="menu-icon">🎁</view>
      <text class="menu-text">礼品管理</text>
    </view>
    <view class="menu-item" bindtap="goLogs">
      <view class="menu-icon">📜</view>
      <text class="menu-text">操作日志</text>
    </view>
  </view>
</view>
