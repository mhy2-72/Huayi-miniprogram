.container { min-height: 100vh; background: #f5f5f5; }
.log-list { padding: 20rpx; }
.log-card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; }
.log-head { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.log-admin { font-size: 28rpx; font-weight: bold; color: #333; }
.log-time { font-size: 24rpx; color: #999; }
.log-action { font-size: 30rpx; color: #07c160; margin-bottom: 8rpx; }
.log-target { font-size: 26rpx; color: #666; margin-bottom: 4rpx; }
.log-detail { font-size: 24rpx; color: #999; line-height: 1.5; }
.empty { text-align: center; color: #999; padding: 80rpx 0; }