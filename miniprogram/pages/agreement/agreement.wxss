.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 80vh;
  padding: 40rpx;
}
.icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}
.title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 60rpx;
}
.view-btn {
  width: 60%;
  background: #007aff;
  color: #fff;
  font-size: 32rpx;
}