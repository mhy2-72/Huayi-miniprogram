<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 加载中提示 -->
  <view wx:if="{{loading}}" class="loading-tip">加载中...</view>

  <!-- 数据加载完成后显示正常内容 -->
  <block wx:else>
    <!-- 生活圈服务入口 -->
    <view class="living-circle-entry" bindtap="goLivingCircle">
      <text class="lc-icon">🏘️</text>
      <view class="lc-text">
        <text class="lc-title">生活圈服务</text>
        <text class="lc-sub">查找附近买菜、买药、银行等服务</text>
      </view>
      <text class="lc-arrow">›</text>
    </view>
    
    <!-- 发布者面板（非 teen 显示） -->
    <view wx:if="{{role !== 'teen'}}" class="elder-panel">
      <button class="publish-btn" bindtap="goPublish">＋ 发布新任务</button>
      
      <view class="section-title">我发布的任务</view>
      <view class="task-list">
        <block wx:for="{{myTasks}}" wx:key="_id">
          <view class="task-card {{statusClass[item.status]}}" bindtap="goDetail" data-id="{{item._id}}">
            <view class="task-content">
              <view class="task-left">
                <text class="desc">{{item.description}}</text>
                <text wx:if="{{item.status === 'cancelled' && item.cancelReason}}" class="cancel-tag">系统取消</text>
              </view>
              <text class="status-text">{{statusText[item.status]}}</text>
            </view>
            <view wx:if="{{item.imageUrls && item.imageUrls.length}}" class="thumb-list">
              <image wx:for="{{item.imageUrls}}" wx:for-item="img" wx:key="index" 
                     class="thumb-img" src="{{img}}" mode="aspectFill"
                     catchtap="previewImage" data-url="{{img}}" data-urls="{{item.imageUrls}}"></image>
            </view>
          </view>
        </block>
        <view wx:if="{{!myTasks.length}}" class="empty">暂无发布的任务</view>
      </view>
    </view>

    <!-- 接取者面板（所有角色均显示） -->
    <view class="youth-panel">
      <view class="section-title">可接任务</view>
      <view class="task-list">
        <block wx:for="{{published}}" wx:key="_id">
          <view class="task-card available-task" bindtap="goDetail" data-id="{{item._id}}">
            <view class="task-content">
              <view class="task-left">
                <text class="desc">{{item.description}}</text>
              </view>
              <button class="accept-btn" catchtap="accept" data-id="{{item._id}}">接取</button>
            </view>
          </view>
        </block>
        <view wx:if="{{!published.length}}" class="empty">暂无可接任务</view>
      </view>

      <view class="section-title">我接取的任务</view>
      <view class="task-list">
        <block wx:for="{{myActive}}" wx:key="_id">
          <view class="task-card {{statusClass[item.status]}}" bindtap="goDetail" data-id="{{item._id}}">
            <view class="task-content">
              <view class="task-left">
                <text class="desc">{{item.description}}</text>
                <text wx:if="{{item.status === 'cancelled' && item.cancelReason}}" class="cancel-tag">系统取消</text>
              </view>
              <text class="status-text">{{statusText[item.status]}}</text>
            </view>
            <view wx:if="{{item.imageUrls && item.imageUrls.length}}" class="thumb-list">
              <image wx:for="{{item.imageUrls}}" wx:for-item="img" wx:key="index" 
                     class="thumb-img" src="{{img}}" mode="aspectFill"
                     catchtap="previewImage" data-url="{{img}}" data-urls="{{item.imageUrls}}"></image>
            </view>
            <view wx:if="{{item.evidenceImageUrls && item.evidenceImageUrls.length}}" class="thumb-list evidence">
              <text class="evidence-label">凭证：</text>
              <image wx:for="{{item.evidenceImageUrls}}" wx:for-item="img" wx:key="index" 
                     class="thumb-img" src="{{img}}" mode="aspectFill"
                     catchtap="previewImage" data-url="{{img}}" data-urls="{{item.evidenceImageUrls}}"></image>
            </view>
          </view>
        </block>
        <view wx:if="{{!myActive.length}}" class="empty">暂无进行中的任务</view>
      </view>
    </view>
  </block>
</view>
