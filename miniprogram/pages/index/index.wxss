.publish-btn {
  width: 100%;
  background: #07c160;
  color: #fff;
  margin-bottom: 30rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 20rpx 0;
}
.task-card {
  background: #fff;
  padding: 20rpx;
  border-radius: 10rpx;
  margin-bottom: 15rpx;
}
.task-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.desc {
  font-size: 30rpx;
  flex: 1;
}
.status-text {
  font-size: 26rpx;
  margin-left: 10rpx;
}
/* 颜色类 */
.status-yellow .desc, .status-yellow .status-text { color: #f0ad4e; }
.status-gray .desc, .status-gray .status-text { color: #999; }
.status-red .desc, .status-red .status-text { color: #d9534f; }
.status-blue .desc, .status-blue .status-text { color: #5bc0de; }

/* 可接任务保持默认，仅按钮变绿色 */
.available-task .desc { color: #333; }
.accept-btn {
  background: #07c160;
  color: #fff;
  font-size: 26rpx;
  padding: 0 20rpx;
  height: 60rpx;
  line-height: 60rpx;
  border: none;
}
.empty {
  text-align: center;
  color: #999;
  padding: 30rpx;
}

/* ========== 取消标签样式 ========== */
.task-left {
  display: flex;
  align-items: center;
  flex: 1;
  gap: 10rpx;
}

.cancel-tag {
  font-size: 20rpx;
  color: #fff;
  background: #c62828;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.task-card.status-gray {
  background: #f5f5f5;
}

/* ========== 图片缩略图样式 ========== */
.thumb-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.thumb-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
}

.evidence {
  border-top-color: #e3f2fd;
}

.evidence-label {
  font-size: 24rpx;
  color: #0d47a1;
  line-height: 120rpx;
  margin-right: 8rpx;
}
.loading-tip {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 30rpx;
}

/* 体验版横幅 */
.guest-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff8e1;
  color: #ff9800;
  font-size: 26rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 10rpx;
  border: 1rpx solid #ffe58f;
}
.guest-banner-icon {
  margin-right: 10rpx;
  font-size: 28rpx;
}
.guest-accept {
  background: #ccc !important;
  color: #666 !important;
  font-size: 28rpx;
}

/* ========== 生活圈服务入口 ========== */
.living-circle-entry {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.lc-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}
.lc-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.lc-title {
  font-size: 32rpx;
  font-weight: bold;
}
.lc-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
.lc-arrow {
  font-size: 40rpx;
  color: #ccc;
}