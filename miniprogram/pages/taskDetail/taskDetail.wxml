<view class="container">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-tip">加载中...</view>

  <!-- 任务详情 -->
  <block wx:elif="{{task}}">
    <!-- 发布者 & 接取者 -->
    <view class="participants">
      <view class="participant">
        <image src="{{elderInfo.avatarUrl || '/images/default-avatar.png'}}" class="participant-avatar"></image>
        <text class="participant-name">{{elderInfo.nickName}}</text>
        <text class="participant-role">发布方</text>
      </view>
      <text class="divider">|</text>
      <view class="participant">
        <image wx:if="{{youthInfo}}" src="{{youthInfo.avatarUrl || '/images/default-avatar.png'}}" class="participant-avatar"></image>
        <text wx:if="{{youthInfo}}" class="participant-name">{{youthInfo.nickName}}</text>
        <text wx:else class="participant-name">暂无接取方</text>
        <text class="participant-role">接取方</text>
      </view>
    </view>

    <!-- 任务信息 -->
    <view class="task-info">
      <text class="label">任务描述</text>
      <text class="value">{{task.description}}</text>
    </view>

    <view class="task-info">
      <text class="label">任务状态</text>
      <text class="value">{{statusText[task.status]}}</text>
    </view>

    <view class="task-info">
      <text class="label">任务难度</text>
      <text class="value">{{task.difficultyText || '未知'}}</text>
    </view>

    <view class="task-info">
      <text class="label">发布时间</text>
      <text class="value">{{task.createTime_str}}</text>
    </view>

    <view class="task-info" wx:if="{{task.acceptTime_str}}">
      <text class="label">接取时间</text>
      <text class="value">{{task.acceptTime_str}}</text>
    </view>

    <view class="task-info" wx:if="{{task.submitTime_str}}">
      <text class="label">提交时间</text>
      <text class="value">{{task.submitTime_str}}</text>
    </view>

    <view class="task-info" wx:if="{{task.completeTime_str}}">
      <text class="label">完成时间</text>
      <text class="value">{{task.completeTime_str}}</text>
    </view>

    <view class="task-info" wx:if="{{task.status === 'published' || task.status === 'accepted'}}">
      <text class="label">截止时间</text>
      <text class="value">{{task.deadline_str}}</text>
    </view>

    <view class="task-info" wx:if="{{task.status === 'cancelled' && task.cancelReason}}">
      <text class="label">取消原因</text>
      <text class="value cancel-reason">{{task.cancelReason}}</text>
    </view>

    <!-- 任务附图（发布者始终可见，接取者接取后可见） -->
    <view wx:if="{{task.imageUrls && task.imageUrls.length && ((role === 'elder' && task.elderId === myOpenid) || (role === 'youth' && task.youthId === myOpenid && task.status !== 'published'))}}">
      <text class="label">任务附图</text>
      <view class="img-list">
        <image wx:for="{{task.imageUrls}}" wx:key="*this" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-url="{{item}}"></image>
      </view>
    </view>

    <!-- 完成凭证 -->
    <view wx:if="{{task.evidenceImageUrls && task.evidenceImageUrls.length}}">
      <text class="label">完成凭证</text>
      <view class="img-list">
        <image wx:for="{{task.evidenceImageUrls}}" wx:key="*this" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-url="{{item}}"></image>
      </view>
    </view>

    <view wx:if="{{task.submitNote}}" class="task-info">
      <text class="label">凭证说明</text>
      <text class="value">{{task.submitNote}}</text>
    </view>

    <!-- 老人操作区 -->
    <view wx:if="{{role === 'elder' && task.elderId === myOpenid}}" class="action-area">
      <button wx:if="{{task.status === 'published'}}" bindtap="cancel" class="btn-cancel">取消任务</button>
      <view wx:if="{{task.status === 'submitted'}}" class="rating-area">
        <text class="rating-title">请评分</text>
        <view class="stars">
          <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" bindtap="setRating" data-val="{{item}}" class="star {{item <= rating ? 'active' : ''}}">★</text>
        </view>
        <button bindtap="confirmComplete" class="btn-confirm">确认完成 ({{rating}}分)</button>
      </view>
    </view>

    <!-- 年轻人操作区 -->
    <view wx:if="{{role === 'youth' && task.youthId === myOpenid}}" class="action-area">
      <button wx:if="{{task.status === 'accepted'}}" bindtap="cancelAccept" class="btn-cancel-accept">取消接取</button>
      <button wx:if="{{task.status === 'accepted'}}" bindtap="goSubmitEvidence" class="btn-submit">上传凭证</button>
    </view>

    <!-- 已完成/已取消状态 -->
    <view wx:if="{{task.status === 'completed'}}" class="status-ended">
      <text>任务已完成</text>
      <text wx:if="{{task.rating}}">，评分：{{task.rating}}分</text>
      <text wx:if="{{task.youthPoints}}">，{{task.youthNickName}}获得{{task.youthPoints}}积分</text>
      <text wx:if="{{task.elderPoints}}">，老人+{{task.elderPoints}}积分</text>
    </view>

    <view wx:if="{{task.status === 'cancelled'}}" class="status-ended">
      <text>任务已取消</text>
    </view>
  </block>

  <!-- 无任务 -->
  <view wx:else class="empty">
    <text>任务不存在或已删除</text>
  </view>
</view>