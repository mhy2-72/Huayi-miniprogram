<!-- miniprogram\pages\register\register.wxml  -->
<view class="container">
  <view class="title">注册账号</view>

  <!-- 头像 -->
  <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
    <image class="avatar" src="{{avatarUrl}}" mode="aspectFill" wx:if="{{avatarUrl}}"></image>
    <text wx:else>点击获取头像</text>
  </button>

  <!-- 昵称 -->
  <input class="input" type="nickname" placeholder="请输入昵称" bindinput="onNickNameInput" value="{{nickName}}"/>

  <!-- 出生日期 -->
  <picker class="picker" mode="date" start="1900-01-01" end="{{today}}" value="{{birthday}}" bindchange="onBirthdayChange">
    <view class="picker-text">{{birthday || '请选择出生日期'}}</view>
  </picker>

  <!-- 性别 -->
  <view class="gender-section">
    <text class="section-title">性别</text>
    <radio-group bindchange="onGenderChange">
      <label class="radio-item" wx:for="{{genders}}" wx:key="value">
        <radio value="{{item.value}}" checked="{{gender === item.value}}"/>{{item.label}}
      </label>
    </radio-group>
  </view>

  <!-- 职业选择 -->
  <view class="section">
    <text class="section-title">职业</text>
    <picker class="picker" mode="selector" range="{{occupations}}" value="{{occupationIndex}}" bindchange="onOccupationChange">
      <view class="picker-text">{{occupations[occupationIndex] || '请选择职业'}}</view>
    </picker>
  </view>

  <!-- 用户协议复选框 -->
  <view class="agreement-section">
    <label class="checkbox-label">
      <checkbox class="checkbox" value="agree" checked="{{agreed}}" bindtap="onAgreeChange"/>
      <text class="agreement-text">我已阅读并同意</text>
      <text class="agreement-link" catchtap="showAgreement">《用户协议》</text>
    </label>
  </view>

  <button class="submit-btn" bindtap="submitRegister" disabled="{{!agreed}}">注册</button>
</view>