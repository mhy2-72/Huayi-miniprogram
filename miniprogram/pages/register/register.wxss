.container {
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 80rpx;
}
.avatar-btn {
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 40rpx;
  padding: 0;
  background: #eee;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar {
  width: 100%;
  height: 100%;
}
.input {
  width: 100%;
  height: 80rpx;
  border: 1px solid #ddd;
  border-radius: 8rpx;
  padding: 0 20rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
}
.picker {
  width: 100%;
  height: 80rpx;
  border: 1px solid #ddd;
  border-radius: 8rpx;
  margin-bottom: 60rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.picker-text {
  color: #666;
}
.submit-btn {
  width: 100%;
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
}
.gender-section {
  margin: 20rpx 0;
}
.section-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}
.radio-item {
  margin-right: 30rpx;
  font-size: 30rpx;
}
.section {
  margin: 20rpx 0;
}
.section-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}
/* 性别选择样式沿用之前的 gender-section，保持一致 */
.agreement-section {
  margin: 30rpx 0;
}
.checkbox-label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}
.checkbox {
  margin-right: 10rpx;
}
.agreement-link {
  color: #007aff;
  text-decoration: underline;
  margin-left: 5rpx;
}
.submit-btn[disabled] {
  background: #ccc;
  color: #999;
}