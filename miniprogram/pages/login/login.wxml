  <!-- miniprogram\pages\login\login.wxml -->
<view class="container">
  <image class="logo" src="/images/logo.png" mode="aspectFit"></image>
  <text class="title">申出圆手</text>
  
  <block wx:if="{{isChecking}}">
    <text class="hint">正在检查账号...</text>
  </block>
  <block wx:elif="{{needRegister}}">
    <text class="hint">欢迎新朋友</text>
    <button class="register-btn" bindtap="goRegister">注册新账号</button>
  </block>
  <block wx:else>
  <text class="hint">欢迎回来，{{userInfo.nickName}} {{greeting}}</text>
  <button class="enter-btn" bindtap="goHome">进入首页</button>
  <!-- 新增AI体验按钮（仅老人端） -->
  <button wx:if="{{userInfo && userInfo.role === 'elder'}}" 
        class="ai-btn" 
        bindtap="goAIChat">AI语音助手(demo)</button>
</block>


  <button wx:if="{{!isChecking && error}}" bindtap="retry" class="retry-btn">网络错误，点击重试</button>

  <!-- 用户协议链接 -->
  <view class="agreement-link" bindtap="showAgreement">用户协议</view>
</view>