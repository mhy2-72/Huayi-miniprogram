.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 40rpx;
}
.logo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  margin-bottom: 30rpx;
}
.title {
  font-size: 50rpx;
  font-weight: bold;
  margin-bottom: 80rpx;
}
.hint {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 50rpx;
}
.register-btn, .enter-btn {
  width: 60%;
  margin-top: 30rpx;
}
.register-btn {
  background: #07c160;
  color: #fff;
}
.enter-btn {
  background: #007aff;
  color: #fff;
}
.retry-btn {
  margin-top: 40rpx;
  background: #fff;
  color: #ff3b30;
  border: 1px solid #ff3b30;
}
.agreement-link {
  position: fixed;
  bottom: 50rpx;
  left: 0;
  width: 100%;
  text-align: center;
  color: #007aff;
  font-size: 26rpx;
  text-decoration: underline;
}

.ai-btn {
  width: 60%;
  background: #FFD700;
  color: #000;
  font-size: 36rpx;
  font-weight: bold;
  margin-top: 30rpx;
  border: 4rpx solid #FF8C00;
}

.admin-divider {
  margin: 30rpx 0 20rpx;
  text-align: center;
  color: #999;
  font-size: 26rpx;
  position: relative;
}
.admin-divider::before,
.admin-divider::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 30%;
  height: 1rpx;
  background: #ddd;
}
.admin-divider::before { left: 10%; }
.admin-divider::after { right: 10%; }
.normal-btn {
  background: #fff !important;
  color: #07c160 !important;
  border: 2rpx solid #07c160 !important;
  margin-top: 20rpx;
}

/* 体验版入口 */
.guest-section {
  margin-top: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.guest-divider {
  display: flex;
  align-items: center;
  width: 80%;
  margin-bottom: 30rpx;
}
.guest-line {
  flex: 1;
  height: 1rpx;
  background: #ddd;
}
.guest-text {
  padding: 0 20rpx;
  color: #999;
  font-size: 26rpx;
}
.guest-btn {
  width: 60%;
  background: #fff;
  color: #07c160;
  border: 2rpx solid #07c160;
  font-size: 32rpx;
}
.guest-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}