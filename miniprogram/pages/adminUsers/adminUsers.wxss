.container { min-height: 100vh; background: #f5f5f5; }
.search-bar { display: flex; padding: 20rpx; background: #fff; gap: 16rpx; }
.search-input { flex: 1; height: 72rpx; border: 1rpx solid #ddd; border-radius: 36rpx; padding: 0 24rpx; font-size: 28rpx; }
.search-btn { font-size: 26rpx; padding: 0 24rpx; height: 72rpx; line-height: 72rpx; background: #07c160; color: #fff; border-radius: 36rpx; }

.user-list { padding: 20rpx; }
.user-card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; display: flex; align-items: center; }
.user-avatar { width: 100rpx; height: 100rpx; border-radius: 50%; margin-right: 20rpx; }
.user-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.user-name { font-size: 30rpx; font-weight: bold; color: #333; }
.user-detail { font-size: 26rpx; color: #666; }
.user-points { font-size: 24rpx; color: #07c160; }
.user-actions { display: flex; gap: 24rpx; }
.action-link { font-size: 28rpx; color: #07c160; }
.action-link.cert { color: #fa8c16; }
.action-link.danger { color: #ff4d4f; }

.user-certs { margin-top: 6rpx; }
.cert-badge { display: inline-block; font-size: 20rpx; color: #fa8c16; background: #fffbe6; padding: 2rpx 10rpx; border-radius: 4rpx; margin-right: 8rpx; border: 1rpx solid #ffe58f; }
.empty { text-align: center; color: #999; padding: 80rpx 0; }

.modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center; }
.modal-content { width: 85%; background: #fff; border-radius: 24rpx; padding: 30rpx; }
.modal-title { font-size: 34rpx; font-weight: bold; text-align: center; margin-bottom: 24rpx; }
.form-item { margin-bottom: 20rpx; }
.form-label { font-size: 28rpx; color: #666; display: block; margin-bottom: 8rpx; }
.form-input { border: 1rpx solid #ddd; border-radius: 8rpx; padding: 16rpx; font-size: 28rpx; }
.modal-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.btn-cancel { flex: 1; background: #f2f3f5; color: #666; border-radius: 40rpx; font-size: 30rpx; }
.btn-save { flex: 1; background: #07c160; color: #fff; border-radius: 40rpx; font-size: 30rpx; }

.avatar-section { display: flex; flex-direction: column; align-items: center; margin-bottom: 30rpx; }
.edit-avatar { width: 140rpx; height: 140rpx; border-radius: 50%; margin-bottom: 16rpx; }
.change-avatar-btn { font-size: 26rpx; background: #f2f3f5; color: #666; border-radius: 32rpx; padding: 0 24rpx; line-height: 1.6; height: auto; min-height: auto; }
.picker-input { display: flex; align-items: center; min-height: 60rpx; }
.role-notice { background: #e6f7ff; border-radius: 8rpx; padding: 16rpx; margin-bottom: 20rpx; font-size: 24rpx; color: #1890ff; text-align: center; }

.current-certs, .add-cert-section { margin-bottom: 24rpx; }
.section-label { font-size: 26rpx; color: #666; display: block; margin-bottom: 12rpx; }
.cert-list { display: flex; flex-direction: column; gap: 12rpx; }
.cert-row { display: flex; justify-content: space-between; align-items: center; padding: 16rpx; background: #fffbe6; border-radius: 8rpx; border: 1rpx solid #ffe58f; }
.cert-row .cert-name { font-size: 28rpx; color: #fa8c16; font-weight: bold; }
.cert-row .cert-remove { font-size: 26rpx; color: #ff4d4f; }
.no-cert-hint { font-size: 26rpx; color: #999; padding: 20rpx; text-align: center; background: #f5f5f5; border-radius: 8rpx; margin-bottom: 24rpx; }
.cert-types { display: flex; gap: 16rpx; flex-wrap: wrap; }
.cert-type-btn { padding: 16rpx 28rpx; background: #e6f7ff; color: #1890ff; border: 1rpx solid #1890ff; border-radius: 8rpx; font-size: 26rpx; }