<!-- pages/notifications/notifications.wxml -->
<view class="container">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{notifications.length === 0}}" class="empty">
    <text>暂无通知</text>
  </view>
  
  <view wx:else>
    <view wx:for="{{notifications}}" wx:key="_id" 
          class="notification-item {{item.read ? 'read' : 'unread'}}"
          bindtap="onNotifTap" 
          data-id="{{item._id}}"
          data-taskid="{{item.taskId}}"
          data-type="{{item.type}}">
      
      <view class="notif-header">
        <view class="notif-title-row">
          <text class="notif-title">{{item.title}}</text>
          <text wx:if="{{item.type === 'complaint'}}" class="result-badge {{item.result === 'approved' ? 'approved' : 'rejected'}}">
            {{item.result === 'approved' ? '已通过' : '已驳回'}}
          </text>
        </view>
        <text wx:if="{{!item.read}}" class="unread-dot">●</text>
      </view>
      
      <view wx:if="{{item.type === 'complaint'}}" class="notif-complaint">
        <view class="complaint-row">
          <text class="complaint-label">处理结果：</text>
          <text class="complaint-status {{item.result === 'approved' ? 'status-approved' : 'status-rejected'}}">
            {{item.result === 'approved' ? '申诉已通过' : '申诉已驳回'}}
          </text>
        </view>
        <view wx:if="{{item.adminReply}}" class="complaint-row">
          <text class="complaint-label">管理员回复：</text>
          <text class="complaint-reply">{{item.adminReply}}</text>
        </view>
        <view wx:if="{{!item.adminReply}}" class="complaint-row">
          <text class="complaint-label">说明：</text>
          <text class="complaint-reply">{{item.message}}</text>
        </view>
      </view>
      <view wx:else class="notif-body">
        <text class="notif-message">{{item.message}}</text>
      </view>
      
      <view class="notif-footer">
        <text class="notif-time">{{item.createTime_str}}</text>
        <text class="notif-type">{{item.type === 'complaint' ? '申诉结果' : (item.type === 'exchange' ? '兑换通知' : (item.type === 'task_cancelled' ? '系统通知' : '任务通知'))}}</text>
      </view>
    </view>
  </view>
</view>