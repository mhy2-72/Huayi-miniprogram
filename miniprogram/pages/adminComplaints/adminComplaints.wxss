.container { min-height: 100vh; background: #f5f5f5; }
.filter-bar { display: flex; background: #fff; padding: 20rpx; gap: 20rpx; }
.filter-item { flex: 1; text-align: center; padding: 16rpx; border-radius: 32rpx; font-size: 28rpx; color: #666; background: #f2f3f5; }
.filter-item.active { background: #07c160; color: #fff; }

.complaint-list { padding: 20rpx; }
.complaint-card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; }
.complaint-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.complaint-type { font-size: 30rpx; font-weight: bold; color: #333; }
.complaint-status { font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 20rpx; }
.complaint-status.pending { background: #fff7e6; color: #fa8c16; }
.complaint-status.resolved { background: #e8f5e9; color: #52c41a; }
.complaint-body { font-size: 28rpx; color: #666; line-height: 1.5; margin-bottom: 12rpx; }
.complaint-meta { font-size: 24rpx; color: #999; }

.empty { text-align: center; color: #999; padding: 80rpx 0; }

/* 详情弹窗 */
.detail-modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 1000;
  display: flex; align-items: flex-end;
}
.detail-content {
  width: 100%; max-height: 85vh; background: #fff;
  border-radius: 24rpx 24rpx 0 0; display: flex; flex-direction: column;
}
.detail-header { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; border-bottom: 1rpx solid #eee; }
.detail-title { font-size: 34rpx; font-weight: bold; }
.detail-close { font-size: 48rpx; color: #999; padding: 0 20rpx; }
.detail-body { flex: 1; padding: 24rpx; max-height: 60vh; }
.detail-row { display: flex; margin-bottom: 16rpx; font-size: 28rpx; }
.label { color: #999; margin-right: 16rpx; }
.detail-section { margin-top: 24rpx; }
.section-title { font-size: 28rpx; font-weight: bold; color: #333; display: block; margin-bottom: 12rpx; }
.change-list { }
.change-item { display: flex; gap: 12rpx; font-size: 26rpx; margin-bottom: 8rpx; flex-wrap: wrap; }
.change-key { color: #666; }
.change-old { color: #ff4d4f; }
.change-new { color: #52c41a; }
.task-link { color: #07c160; font-size: 28rpx; padding: 16rpx 0; }
.exchange-info { font-size: 26rpx; color: #666; display: flex; flex-direction: column; gap: 8rpx; }
.complaint-desc { font-size: 28rpx; color: #333; line-height: 1.6; background: #f9f9f9; padding: 20rpx; border-radius: 12rpx; }
.evidence-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.evidence-img { width: 200rpx; height: 200rpx; border-radius: 12rpx; }
.admin-note { font-size: 26rpx; color: #666; line-height: 1.5; background: #f0f9ff; padding: 20rpx; border-radius: 12rpx; }

.exchange-list { display: flex; flex-direction: column; gap: 12rpx; }
.exchange-item { background: #f9f9f9; border-radius: 8rpx; padding: 16rpx; display: flex; flex-direction: column; gap: 6rpx; }
.exchange-product { font-size: 28rpx; font-weight: bold; color: #333; }
.exchange-code { font-size: 26rpx; color: #07c160; }
.exchange-time { font-size: 24rpx; color: #999; }
.exchange-status { font-size: 24rpx; padding: 4rpx 12rpx; border-radius: 16rpx; align-self: flex-start; }
.exchange-status.pending { background: #fff7e6; color: #fa8c16; }
.exchange-status.used { background: #f0f0f0; color: #999; }
.empty-hint { text-align: center; color: #999; font-size: 26rpx; padding: 20rpx; }

.detail-actions { display: flex; gap: 20rpx; padding: 24rpx; border-top: 1rpx solid #eee; }
.btn-approve { flex: 1; background: #07c160; color: #fff; font-size: 30rpx; border-radius: 40rpx; }
.btn-reject { flex: 1; background: #fff; color: #ff4d4f; border: 2rpx solid #ff4d4f; font-size: 30rpx; border-radius: 40rpx; }

.lc-subtype { font-size: 28rpx; color: #07c160; font-weight: bold; }
.lc-target { font-size: 26rpx; color: #666; background: #f9f9f9; padding: 12rpx; border-radius: 8rpx; word-break: break-all; }
.lc-newpoi { background: #f0f9ff; padding: 16rpx; border-radius: 12rpx; }
.lc-field { display: flex; font-size: 26rpx; margin-bottom: 8rpx; }
.lc-label { color: #999; width: 140rpx; flex-shrink: 0; }
.lc-notice { font-size: 24rpx; color: #fa8c16; margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx dashed #e0e0e0; }

.required-hint { font-size: 24rpx; color: #fa8c16; margin-top: 12rpx; }

.sub-section { margin-top: 20rpx; }

.poi-picker { margin-bottom: 16rpx; }

.address-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}
.address-input { flex: 1; }
.location-btn {
  font-size: 24rpx;
  padding: 12rpx 20rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  line-height: 1.4;
  height: auto;
  min-height: auto;
  white-space: nowrap;
}