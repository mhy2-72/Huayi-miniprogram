.container { min-height: 100vh; background: #f5f5f5; }
.top-bar { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; background: #fff; }
.top-title { font-size: 36rpx; font-weight: bold; }
.top-actions { display: flex; gap: 16rpx; }
.action-btn { font-size: 26rpx; padding: 12rpx 24rpx; border-radius: 32rpx; background: #f2f3f5; color: #333; line-height: 1.4; height: auto; min-height: auto; }
.action-btn.primary { background: #07c160; color: #fff; }

.product-list { padding: 20rpx; }
.product-card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; }
.product-info { margin-bottom: 16rpx; }
.product-name { font-size: 32rpx; font-weight: bold; color: #333; display: block; }
.product-desc { font-size: 26rpx; color: #999; margin-top: 8rpx; display: block; }
.product-meta { display: flex; gap: 30rpx; margin-top: 12rpx; }
.product-points { color: #ff4d4f; font-size: 28rpx; font-weight: bold; }
.product-stock { color: #666; font-size: 26rpx; }
.product-actions { display: flex; justify-content: flex-end; gap: 30rpx; border-top: 1rpx solid #f0f0f0; padding-top: 16rpx; }
.action-link { font-size: 28rpx; color: #07c160; }
.action-link.danger { color: #ff4d4f; }

.empty { text-align: center; color: #999; padding: 80rpx 0; }

/* 弹窗 */
.modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center; }
.modal-content { width: 85%; max-height: 80vh; background: #fff; border-radius: 24rpx; padding: 30rpx; }
.modal-content.small { max-height: 70vh; }
.modal-title { font-size: 34rpx; font-weight: bold; text-align: center; margin-bottom: 24rpx; }
.form-item { margin-bottom: 20rpx; }
.form-label { font-size: 28rpx; color: #666; display: block; margin-bottom: 8rpx; }
.form-input { border: 1rpx solid #ddd; border-radius: 8rpx; padding: 16rpx; font-size: 28rpx; }
.form-textarea { border: 1rpx solid #ddd; border-radius: 8rpx; padding: 16rpx; font-size: 28rpx; width: 100%; min-height: 120rpx; }
.modal-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.btn-cancel { flex: 1; background: #f2f3f5; color: #666; border-radius: 40rpx; font-size: 30rpx; }
.btn-save { flex: 1; background: #07c160; color: #fff; border-radius: 40rpx; font-size: 30rpx; }

.code-list { max-height: 50vh; }
.code-item { background: #f9f9f9; border-radius: 12rpx; padding: 20rpx; margin-bottom: 16rpx; display: flex; justify-content: space-between; align-items: flex-start; }
.code-info { flex: 1; }
.code-product { font-size: 30rpx; font-weight: bold; color: #333; display: block; }
.code-value { font-size: 28rpx; color: #07c160; margin-top: 8rpx; display: block; }
.code-user { font-size: 24rpx; color: #666; margin-top: 4rpx; display: block; }
.code-time { font-size: 24rpx; color: #999; margin-top: 4rpx; display: block; }
.code-status { font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 20rpx; }
.code-status.pending { background: #fff7e6; color: #fa8c16; }
.code-status.used { background: #e8e8e8; color: #999; }