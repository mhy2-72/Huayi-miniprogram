.container { display: flex; flex-direction: column; height: 100vh; background: #f5f5f5; position: relative; }
.voice-toggle { position: absolute; top: 20rpx; right: 30rpx; z-index: 10; }
.voice-icon { width: 40rpx; height: 40rpx; }
.chat-list { flex: 1; padding: 20rpx; overflow-y: auto; padding-top: 80rpx; }

/* 加载遮罩层 */
.loading-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #f5f5f5;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}
.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #ddd;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  margin-top: 30rpx;
  font-size: 30rpx;
  color: #666;
}

/* ===== 消息列表：从底部排列 ===== */
.msg-list {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 100%;          /* 保证至少占满 scroll-view 可视区，使消息贴底 */
  padding-top: 20rpx;
}
.msg-item {
  max-width: 80%;
  margin-bottom: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
}
.user-msg { align-self: flex-end; background: #95ec69; color: #000; }
.ai-msg { align-self: flex-start; background: #fff; color: #333; }
.play-btn { margin-top: 10rpx; font-size: 40rpx; display: inline-block; }

/* 使用提示 */
.usage-tip-wrapper {
  flex-shrink: 0;
  padding: 0 20rpx 10rpx 20rpx;
}
.usage-tip {
  padding: 30rpx 40rpx;
  background: #fff;
  border-radius: 20rpx;
  width: 100%;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  box-sizing: border-box;
}
.tip-title { font-size: 34rpx; font-weight: bold; color: #333; display: block; margin-bottom: 30rpx; }
.tip-item { font-size: 28rpx; color: #666; display: block; margin-bottom: 15rpx; }
.tip-desc { font-size: 26rpx; color: #999; margin-top: 20rpx; display: block; }

/* 输入区域 */
.input-area { padding: 20rpx; background: #fff; display: flex; align-items: center; border-top: 1rpx solid #eee; }
.text-input { flex: 1; height: 80rpx; border: 1rpx solid #ddd; border-radius: 40rpx; padding: 0 30rpx; font-size: 30rpx; background: #f9f9f9; margin-right: 20rpx; }
button.send-btn {
  width: 120rpx;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  line-height: 80rpx;
  text-align: center;
  border: none;
  padding: 0;
  background-color: #ccc;
  color: #666;
}
button.send-btn.active {
  background-color: #07c160;
  color: #fff;
}

/* 任务卡片 */
.task-card {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: #f0f9ff;
  border-left: 6rpx solid #07c160;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #07c160;
}
.card-name {
  font-size: 32rpx;
  color: #333;
  margin: 10rpx 0;
}
.card-tip {
  font-size: 26rpx;
  color: #999;
  align-self: flex-end;
}

/* 生活圈卡片 */
.lc-notice {
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  background: #fff7e6;
  border: 1rpx solid #ffe4b5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #ad6800;
  line-height: 1.5;
}
.poi-card {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border: 1rpx solid #e8f5e9;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.poi-card.out-range {
  opacity: 0.7;
  background: #f9f9f9;
  border-color: #e0e0e0;
}
.poi-head {
  display: flex;
  align-items: center;
  width: 100%;
}
.poi-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}
.poi-range-tag {
  font-size: 22rpx;
  color: #07c160;
  background: #e8f5e9;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  margin-left: 12rpx;
}
.poi-range-tag.out {
  color: #999;
  background: #e8e8e8;
}
.poi-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}
.poi-addr {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999;
}
.poi-meta {
  display: flex;
  align-items: center;
  width: 100%;
  margin-top: 12rpx;
  font-size: 24rpx;
}
.poi-cat {
  color: #07c160;
  margin-right: 12rpx;
}
.poi-dist {
  color: #999;
  margin-right: 12rpx;
}
.poi-rating {
  color: #f0ad4e;
  margin-right: auto;
}
.poi-nav {
  color: #07c160;
}
.lc-empty {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #999;
  text-align: center;
}
.lc-more {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #07c160;
  text-align: center;
}

/* ===== 角色样式 ===== */
.character-container {
  position: absolute;
  top: 30%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 300rpx;
  z-index: 10;
  transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.character-container.moved {
  top: 20rpx;
  left: 20rpx;
  transform: none;
  width: 25vw;
}
.character-spacer {
  width: 100%;
  height: auto;
  visibility: hidden;
  display: block;
}
.character-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: auto;
  display: block;
  will-change: opacity;
  backface-visibility: hidden;
  transition: opacity 0.06s ease-out;
}
.img-active {
  opacity: 1;
  z-index: 2;
}
.img-inactive {
  opacity: 0;
  z-index: 1;
  pointer-events: none;
}