.container { min-height: 100vh; background: #f5f5f5; padding: 20rpx; }
.section { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 20rpx; }
.section-title { font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 16rpx; }
.required { color: #ff4d4f; }
.optional { color: #999; font-size: 24rpx; }

.type-list { display: flex; gap: 16rpx; flex-wrap: wrap; }
.type-item { padding: 16rpx 28rpx; background: #f2f3f5; border-radius: 32rpx; font-size: 28rpx; color: #666; }
.type-item.active { background: #e6f7ff; color: #1890ff; border: 1rpx solid #1890ff; }

.change-form { display: flex; flex-direction: column; gap: 12rpx; margin-bottom: 16rpx; }
.form-input { border: 1rpx solid #ddd; border-radius: 8rpx; padding: 16rpx; font-size: 28rpx; }
.add-btn { font-size: 26rpx; padding: 12rpx; background: #07c160; color: #fff; border-radius: 32rpx; align-self: flex-start; line-height: 1.4; height: auto; min-height: auto; }
.change-list { }
.change-item { display: flex; justify-content: space-between; align-items: center; padding: 16rpx; background: #f9f9f9; border-radius: 8rpx; margin-bottom: 12rpx; }
.change-text { font-size: 26rpx; color: #333; }
.change-del { font-size: 24rpx; color: #ff4d4f; }
.empty-hint { text-align: center; color: #999; font-size: 26rpx; padding: 20rpx; }

.task-list { }
.task-item { padding: 20rpx; background: #f9f9f9; border-radius: 8rpx; margin-bottom: 12rpx; border-left: 4rpx solid transparent; }
.task-item.active { border-left-color: #1890ff; background: #e6f7ff; }
.task-desc { font-size: 28rpx; color: #333; display: block; }
.task-status { font-size: 24rpx; color: #666; margin-top: 6rpx; }

.hint-text { font-size: 26rpx; color: #666; line-height: 1.6; }

.description-input { width: 100%; min-height: 200rpx; font-size: 28rpx; padding: 16rpx; border: 1rpx solid #ddd; border-radius: 8rpx; box-sizing: border-box; }

.image-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.image-item { position: relative; width: 180rpx; height: 180rpx; }
.image-preview { width: 100%; height: 100%; border-radius: 8rpx; }
.image-del { position: absolute; top: -10rpx; right: -10rpx; width: 40rpx; height: 40rpx; background: #ff4d4f; color: #fff; border-radius: 50%; text-align: center; line-height: 40rpx; font-size: 28rpx; }
.image-add { width: 180rpx; height: 180rpx; border: 2rpx dashed #ccc; border-radius: 8rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #fafafa; }
.add-icon { font-size: 60rpx; color: #ccc; }
.add-text { font-size: 24rpx; color: #999; }

.submit-btn { margin-top: 40rpx; background: #07c160; color: #fff; font-size: 32rpx; border-radius: 48rpx; height: 88rpx; line-height: 88rpx; }

.contact-hint { text-align: center; font-size: 24rpx; color: #999; margin-top: 30rpx; padding-bottom: 40rpx; }

.page-header {
  background: linear-gradient(135deg, #07c160, #06a050);
  border-radius: 12rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
}
.guest-tip-bar { display: flex; align-items: center; justify-content: center; background: #fff8e1; color: #ff9800; font-size: 26rpx; padding: 12rpx 20rpx; margin-bottom: 20rpx; border-radius: 8rpx; }
.guest-tip-icon { margin-right: 10rpx; }
.guest-tip-text { }
.page-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}
.page-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}

.cert-list { display: flex; flex-direction: column; gap: 16rpx; }
.cert-item {
  padding: 24rpx;
  background: #f9f9f9;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  transition: all 0.2s;
}
.cert-item.active {
  background: #e6f7ff;
  border-color: #1890ff;
}
.cert-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}
.cert-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
}

.required-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #fa8c16;
  background: #fffbe6;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
}